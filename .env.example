# Copy to .env and fill in. Keys are flavor-prefixed (DEV_ / PROD_).

DEV_BASE_URL=https://dev.blob.example
DEV_DEEPLINK_HOST=dev.blob.example
DEV_ZITADEL_ISSUER=https://auth.dev.blob.example
DEV_ZITADEL_CLIENT_ID=
DEV_ZITADEL_REDIRECT_URL=com.mamajees.blob.app.dev:/oauthredirect
DEV_ZITADEL_API_CLIENT_ID=
DEV_MEASURE_ENABLED=false
# Self-hosted measure.sh (dashboard Apps → API URL + platform API keys)
DEV_MEASURE_API_URL=https://measure-api.example
DEV_MEASURE_API_KEY_ANDROID=
DEV_MEASURE_API_KEY_IOS=

PROD_BASE_URL=https://blob.example
PROD_DEEPLINK_HOST=blob.example
PROD_ZITADEL_ISSUER=https://auth.blob.example
PROD_ZITADEL_CLIENT_ID=
PROD_ZITADEL_REDIRECT_URL=com.mamajees.blob.app:/oauthredirect
PROD_ZITADEL_API_CLIENT_ID=
PROD_MEASURE_ENABLED=false
PROD_MEASURE_API_URL=https://measure-api.example
PROD_MEASURE_API_KEY_ANDROID=
PROD_MEASURE_API_KEY_IOS=
